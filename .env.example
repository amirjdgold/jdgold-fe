# Frontend API base (include /api).
# Leave empty for local Vite dev (proxy: /api → http://localhost:3001).
# On Vercel, set this at build time — Vite embeds VITE_* into the static bundle.
# Origin-only values (no /api, no trailing slash) also work; api.ts appends /api.
# Examples:
#   VITE_API_URL=http://localhost:5000/api
#   VITE_API_URL=http://localhost:3001/api
#   VITE_API_URL=https://your-backend.vercel.app/api
#   VITE_API_URL=https://jdg-web-backend.vercel.app
#
# Do not put production secrets or API keys here.
VITE_API_URL=
