# Frontend API base (include /api).
# Leave empty for local Vite dev (proxy: /api → backend).
# Examples:
#   VITE_API_URL=http://localhost:5000/api
#   VITE_API_URL=http://localhost:3001/api
#   VITE_API_URL=https://your-backend.vercel.app/api
#
# Do not put production secrets or API keys here.
VITE_API_URL=
